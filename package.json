{
  "name": "basecred-sdk",
  "version": "0.1.1",
  "description": "A neutral SDK that fetches and assembles reputation data from Ethos Network and Talent Protocol without interpretation, ranking, or judgment.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "reputation",
    "credibility",
    "identity",
    "ethos",
    "talent-protocol",
    "web3",
    "sdk",
    "signals"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GeoartStudio/basecred-sdk"
  },
  "homepage": "https://basecredsdk.geoart.studio"
}